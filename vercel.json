{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mirage",
      "has": [
        {
          "type": "host",
          "value": "hypertarget.tech"
        }
      ],
      "destination": "https://mirage.hypertarget.tech/",
      "permanent": true
    },
